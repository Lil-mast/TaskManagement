# Growth Copilot — Phase 0 status template (env example)
# Copy to backend/.env and fill in.

# --- Server ---
GROWTH_PORT=8000
# Comma-separated list of allowed SPA origins
GROWTH_CORS_ORIGINS=http://localhost:5173

# --- Database (optional in Phase 0; enables task persistence) ---
# GROWTH_DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Anthropic (LLM) ---
GROWTH_ANTHROPIC_API_KEY=
GROWTH_ANTHROPIC_MODEL=claude-sonnet-5-5
GROWTH_ANTHROPIC_MAX_TOKENS=4096
# Input guard: reject prompts larger than this many characters
GROWTH_ANTHROPIC_MAX_INPUT_CHARS=60000

# --- Rate limiting (LLM) ---
GROWTH_RATE_LIMIT_RPM=20
GROWTH_RATE_LIMIT_CONCURRENCY=3
GROWTH_MAX_RETRIES=4

# --- Firebase (when absent the API runs in local dev mode) ---
GROWTH_FIREBASE_PROJECT_ID=

# --- daily.dev (Phase 1) ---
# Personal access token from https://app.daily.dev/settings/api
GROWTH_DAILY_DEV_TOKEN=

# --- Cron (Phase 1) ---
# Shared secret guarding POST /cron/briefing (required to enable the route)
GROWTH_CRON_SECRET=
