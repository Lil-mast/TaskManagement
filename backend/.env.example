# Copy to backend/.env and fill in.

# --- Server ---
GROWTH_PORT=8000
# Comma-separated list of allowed SPA origins
GROWTH_CORS_ORIGINS=http://localhost:5173

# --- Database (optional in Phase 0; enables task persistence) ---
# GROWTH_DATABASE_URL=postgresql://user:pass@host:5432/db

# --- Anthropic (LLM) ---
GROWTH_ANTHROPIC_API_KEY=
GROWTH_ANTHROPIC_MODEL=claude-sonnet-5-5
GROWTH_ANTHROPIC_MAX_TOKENS=4096
# Input guard: reject prompts larger than this many characters
GROWTH_ANTHROPIC_MAX_INPUT_CHARS=60000

# --- Rate limiting (LLM) ---
GROWTH_RATE_LIMIT_RPM=20
GROWTH_RATE_LIMIT_CONCURRENCY=3
GROWTH_MAX_RETRIES=4

# --- Identity (2026-10-20 decision: Firebase IS the sign-in provider) ---
# The SPA signs in via Firebase (incl. Google OAuth popup, email, phone) and
# sends its ID token as Bearer; the backend verifies it against Google's JWKS.
GROWTH_FIREBASE_PROJECT_ID=<your-firebase-project-id>
# OPTIONAL alternate source (Supabase is the data plane; its Auth is NOT used).
# Set GROWTH_SUPABASE_URL only if you someday migrate off Firebase.
GROWTH_SUPABASE_URL=
# Only needed for Supabase projects still on the symmetric (HS256) JWT secret:
GROWTH_SUPABASE_JWT_SECRET=

# --- Access policy (invite-only) ---
# The admin is exempt from user rate limits. Prefer verified emails; UID lists
# are useful for phone-only identities.
GROWTH_ADMIN_EMAILS=
GROWTH_ADMIN_USER_IDS=
# Everyone else must be on one of these lists to use /api routes.
GROWTH_ALLOWED_EMAILS=
GROWTH_ALLOWED_USER_IDS=
# Firebase email/password accounts must verify before the allowlist applies.
GROWTH_REQUIRE_VERIFIED_EMAIL=true
# Per-user budgets. Admin bypasses both.
GROWTH_USER_RATE_LIMIT_RPM=60
GROWTH_USER_LLM_LIMIT_PER_HOUR=10
# Local-only escape hatch: accepts Bearer "dev" as local_dev. Never enable on a
# public deployment. Leave blank/false when Firebase is configured.
GROWTH_ALLOW_DEV_AUTH=true

# --- daily.dev (Phase 1) ---
# Personal access token from https://app.daily.dev/settings/api
GROWTH_DAILY_DEV_TOKEN=

# --- Cron (Phase 1) ---
# Shared secret guarding POST /cron/briefing (required to enable the route)
GROWTH_CRON_SECRET=

# --- Google integration (Phase 3 calendar / Phase 4 gmail) ---
# Google Cloud console → OAuth client (web), authorized redirect:
#   http://localhost:8000/api/integrations/google/callback
# One OAuth client serves BOTH consents (calendar read-only + gmail read-only).
GROWTH_GOOGLE_CLIENT_ID=
GROWTH_GOOGLE_CLIENT_SECRET=
GROWTH_GOOGLE_REDIRECT_URL=http://localhost:8000/api/integrations/google/callback
# hex-encoded 32-byte master key for AES-GCM token encryption:
#   openssl rand -hex 32
GROWTH_TOKEN_ENC_KEY=

# --- Email triage (Phase 4) ---
# The /api/email/* routes reuse the Google OAuth client above (gmail.readonly).

# --- Embeddings / RAG (Phase 2) ---
# AgentRouter key (sk-ar-...) from https://agentrouter.org → API Keys.
# serve embeddings. Routing rules require /v1 in the base URL.
GROWTH_EMBEDDINGS_API_KEY=
GROWTH_EMBEDDINGS_MODEL=text-embedding-3-small
# Optional override (defaults to https://agentrouter.org/v1);
# e.g. back to OpenAI directly: https://api.openai.com/v1
# GROWTH_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# MUST match migration 0002's vector(N) column
GROWTH_EMBEDDINGS_DIM=1536
# Where POST /api/knowledge/ingest (empty body) reads books JSON from
GROWTH_BOOKS_DIR=data/books
