{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eisenhower-matrix",
  "main": "./src/index.ts",
  "compatibility_date": "2026-04-13",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
