# SPA — copy to .env.local and fill only what the deployment has.

# Backend origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# dev      → sends the literal token "dev" (backend must have NO identity provider configured)
# firebase → signs in through Firebase and sends the ID token
VITE_AUTH_MODE=dev
VITE_DEV_TOKEN=dev

# Firebase web config — required when VITE_AUTH_MODE=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
