# SPA — copy to .env.local and fill only what the deployment has.

# Backend origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# dev      → sends the literal token "dev" (backend must opt in with GROWTH_ALLOW_DEV_AUTH=true)
# firebase → signs in through Firebase and sends the ID token
# Omit VITE_AUTH_MODE to auto-detect: Firebase when all VITE_FIREBASE_* values are set,
# otherwise dev in development.
VITE_AUTH_MODE=dev
VITE_DEV_TOKEN=dev

# Firebase web config — required when VITE_AUTH_MODE=firebase.
# Accounts are invite-only; configure GROWTH_ADMIN_EMAILS / GROWTH_ALLOWED_EMAILS
# on the backend before signing in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
