# SPA — copy to .env.local and fill only what the deployment has.

# Backend origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# dev      → sends the literal token "dev" (backend must opt in with GROWTH_ALLOW_DEV_AUTH=true)
# neon     → signs in through Neon Auth and sends its access token
# Omit VITE_AUTH_MODE to auto-detect: Neon when VITE_NEON_AUTH_URL is set,
# otherwise dev in development.
VITE_AUTH_MODE=dev
VITE_DEV_TOKEN=dev

# Neon Auth — configure the GitHub OAuth provider in Neon Auth settings.
VITE_NEON_AUTH_URL=
