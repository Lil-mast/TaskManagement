# SPA — copy to .env.local and fill only what the deployment has.

# Backend origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# dev      → sends the literal token "dev" (backend must opt in with GROWTH_ALLOW_DEV_AUTH=true)
# supabase → signs in through Supabase Auth and sends its access token
# Omit VITE_AUTH_MODE to auto-detect: Supabase when both VITE_SUPABASE_* values are set,
# otherwise dev in development.
VITE_AUTH_MODE=dev
VITE_DEV_TOKEN=dev

# Supabase Auth — configure the GitHub provider in Supabase Auth settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
